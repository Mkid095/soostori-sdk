{
  "name": "@soostori/lan",
  "version": "0.1.1-alpha.4",
  "description": "LAN discovery + WebSocket protocol — extracted from Desktop's sync infrastructure",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint": "echo 'lint placeholder'"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@soostori/core": "workspace:*",
    "@soostori/events": "workspace:*",
    "@soostori/devices": "workspace:*",
    "ws": "^8.18.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^2.1.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.10"
  },
  "license": "BSL-1.1",
  "private_publish_token_env": "NPM_TOKEN",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mkid095/soostori-sdk.git"
  }
}
