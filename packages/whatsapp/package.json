{
  "name": "@soostori/whatsapp",
  "version": "0.1.0",
  "description": "WhatsApp integration via Evolution API — self-hosted, no third-party tokens",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
      "typecheck": "tsc --noEmit -p tsconfig.json",
      "test": "vitest run",
      "lint": "echo 'lint placeholder'"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@soostori/core": "workspace:*",
    "@soostori/events": "workspace:*",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^2.1.0",
    "@types/node": "^22.0.0"
  },
  "license": "UNLICENSED",
  "private_publish_token_env": "NPM_TOKEN"
}
