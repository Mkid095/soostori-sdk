{
  "name": "@soostori/auth",
  "version": "0.1.0-alpha.7",
  "description": "Cloud auth (Google OAuth, email/password, session) + OperationalAuth (device-local PIN, enrollment)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "react-native": {
        "default": "./dist/pin-rn.js"
      },
      "default": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    },
    "./pin-node": {
      "types": "./dist/pin-node.d.ts",
      "default": "./dist/pin-node.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint": "echo 'lint placeholder'"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@soostori/core": "workspace:^",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "license": "BSL-1.1",
  "private_publish_token_env": "NPM_TOKEN",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mkid095/soostori-sdk.git"
  }
}
