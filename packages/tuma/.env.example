# Tuma payment credentials — get these from your Tuma dashboard at
# https://merchant.tuma.co.ke
#
# SECURITY: This file is for LOCAL DEVELOPMENT ONLY.
# NEVER commit actual values to git. Add `.env*` to `.gitignore`.
# Set these as environment variables in production / CI.

# Business email registered with Tuma
TUMA_BUSINESS_EMAIL=your-business@example.com

# API key from the Tuma dashboard
# Use the TUMA_API_KEY environment variable, NOT a literal value here.
TUMA_API_KEY=replace-with-env-var

# Optional: Tuma staging API base URL (do NOT change in production)
# TUMA_BASE_URL=https://api.tuma.co.ke
