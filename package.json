{
  "name": "@soostori/sdk",
  "version": "0.1.0",
  "private": true,
  "description": "Soostori shared SDK — canonical contract for Web, Mobile, and Desktop",
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" run build",
    "test": "vitest run",
    "typecheck": "pnpm -r --filter \"./packages/*\" run typecheck",
    "lint": "pnpm -r --filter \"./packages/*\" run lint"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "devDependencies": {
    "typescript": "^5.7.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^2.1.9"
  },
  "pnpm": {
    "overrides": {
      "@soostori/audit": "workspace:*",
      "@soostori/auth": "workspace:*",
      "@soostori/business": "workspace:*",
      "@soostori/cloud": "workspace:*",
      "@soostori/contracts": "workspace:*",
      "@soostori/core": "workspace:*",
      "@soostori/devices": "workspace:*",
      "@soostori/events": "workspace:*",
      "@soostori/inventory": "workspace:*",
      "@soostori/schema": "workspace:*",
      "@soostori/storage": "workspace:*",
      "@soostori/subscription": "workspace:*",
      "@soostori/sync": "workspace:*"
    }
  }
}
