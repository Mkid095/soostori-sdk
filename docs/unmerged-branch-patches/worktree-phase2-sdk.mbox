+  // ── revoke invitation ──────────────────────────────────────────────────────
+
+  /**
+   * Revoke a pending invitation — cancelled by the owner before acceptance.
+   * Idempotent: returns without error if invitation does not exist.
+   */
+  async revokeInvitation(input: RevokeInvitationInput): Promise<void> {
+    const invitation = await this.repo.getInvitation(input.invitationId)
+    if (!invitation) return
+    if (invitation.businessId !== this.businessId) {
+      throw new Error('Business isolation violation')
+    }
+    if (invitation.status !== 'pending') {
+      throw new Error(`Invitation is ${invitation.status}, cannot revoke`)
+    }
+
+    await this.repo.updateInvitationStatus(input.invitationId, 'revoked')
+    await this.emit('team.invitation.revoked', invitation, 'update')
+  }
+
+  // ── resend invitation ─────────────────────────────────────────────────────
+
+  /**
+   * Resend a pending invitation with a fresh expiry.
+   * Issues a new `expiresAt` (7 days from now) but keeps the same idempotency key.
+   * Idempotent: returns the current invitation if already accepted/expired/revoked.
+   */
+  async resendInvitation(input: ResendInvitationInput): Promise<TeamInvitation> {
+    const invitation = await this.repo.getInvitation(input.invitationId)
+    if (!invitation) throw new Error(`Invitation ${input.invitationId} not found`)
+    if (invitation.businessId !== this.businessId) {
+      throw new Error('Business isolation violation')
+    }
+    if (invitation.status !== 'pending') {
+      throw new Error(`Invitation is ${invitation.status}, cannot resend`)
+    }
+
+    const now = new Date().toISOString() as ISO8601
+    const expiresAt = new Date(Date.now() + 7 * 24 * 60 * 60 * 1000).toISOString() as ISO8601
+
+    const updated: TeamInvitation = {
+      ...invitation,
+      expiresAt,
+      createdAt: now,
+    }
+
+    await this.repo.upsertInvitation(updated)
+    await this.emit('team.invitation.created', updated, 'update')
+
+    return updated
+  }
+
   // ── emit ─────────────────────────────────────────────────────────────────────
 
   private async emit(
