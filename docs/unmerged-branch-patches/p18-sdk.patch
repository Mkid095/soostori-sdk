+export const PARTNER_APPROVAL_CREATED = 'partner.approval.created'
+export const PARTNER_REFERRAL_CREATED = 'partner.referral.created'
+export const BUSINESS_ENROLLMENT_CREATED = 'business.enrollment.created'
+export const CONVERSION_QUALIFIED = 'conversion.qualified'
+export const COMMISSION_EARNING_CREATED = 'commission.earning.created'
+export const INFLUENCER_EARNING_CREATED = 'influencer.earning.created'
