+/**
+ * PartnerService — unit tests.
+ *
+ * Tests:
+ *   submitApplication — idempotency + field construction
+ *   approveApplication — PartnerApproval creation + app status update
+ *   createReferral — immutability (throws if referral already exists)
+ */
+
+import { describe, it, expect, vi, beforeEach } from 'vitest'
+import { newId } from '@soostori/core'
+import type {
+  SalespersonApplicationId, SalespersonProfileId,
+  InfluencerProfileId, PersonId, BusinessId, DeviceId, EmployeeId,
+} from '@soostori/core'
+
+import type {
+  PartnerApplication,
+  PartnerApproval,
+  PartnerReferral,
+  SubmitPartnerApplicationInput,
+  ApprovePartnerApplicationInput,
+  CreateReferralInput,
+} from '../src/types.js'
+import type { PartnerRepository } from '../src/repository.js'
+import type { SyncEngine } from '@soostori/contracts'
+
+import { PartnerService } from '../src/partner-service.js'
+
+// ── Mock implementations ───────────────────────────────────────────────────────
+
+function createMockRepo() {
+  const store = {
+    applications: new Map<string, PartnerApplication>(),
+    approvals: new Map<string, PartnerApproval>(),
+    referrals: new Map<SalespersonProfileId, PartnerReferral>(),
+  }
+
+  return {
+    store,
+    upsertApplication: vi.fn(async (app: PartnerApplication) => {
+      store.applications.set(app.id, app)
+    }),
+    getApplication: vi.fn(async (id: SalespersonApplicationId) => {
+      return store.applications.get(id as string) ?? null
+    }),
+    listApplicationsByStatus: vi.fn(async (_status: PartnerApplication['status']) => {
+      return Array.from(store.applications.values())
+    }),
+    upsertApproval: vi.fn(async (approval: PartnerApproval) => {
+      store.approvals.set(approval.id, approval)
+    }),
+    getApprovalByApplication: vi.fn(async (applicationId: SalespersonApplicationId) => {
+      return Array.from(store.approvals.values()).find(a => a.applicationId === applicationId) ?? null
+    }),
+    upsertReferral: vi.fn(async (referral: PartnerReferral) => {
+      store.referrals.set(referral.salespersonProfileId, referral)
+    }),
+    getReferralBySalesperson: vi.fn(async (salespersonId: SalespersonProfileId) => {
+      return store.referrals.get(salespersonId) ?? null
+    }),
+    upsertEnrollment: vi.fn(),
+    getEnrollmentByBusiness: vi.fn(),
+    listEnrollmentsBySalesperson: vi.fn(),
+    listEnrollmentsByInfluencer: vi.fn(),
+    upsertConversion: vi.fn(),
+    getConversion: vi.fn(),
+    listConversionsByEnrollment: vi.fn(),
+    upsertEarning: vi.fn(),
+    getEarningByIdempotencyKey: vi.fn(),
+    listEarningsBySalesperson: vi.fn(),
+    upsertInfluencerEarning: vi.fn(),
+    getInfluencerEarningByIdempotencyKey: vi.fn(),
+    listInfluencerEarningsByInfluencer: vi.fn(),
+  } satisfies PartnerRepository
+}
+
+function createMockSyncEngine() {
+  return {
+    enqueue: vi.fn(async () => {}),
+  } satisfies unknown as SyncEngine
+}
+
+// ── Test helpers ───────────────────────────────────────────────────────────────
+
+const DEVICE_ID = 'dev-001' as DeviceId
+const EMPLOYEE_ID = 'emp-001' as EmployeeId
+const PERSON_ID = 'pers-001' as PersonId
+const SALESPERSON_PROFILE_ID = 'sp-001' as SalespersonProfileId
+const INFLUENCER_PROFILE_ID = 'inf-001' as InfluencerProfileId
+
+// ── Tests ──────────────────────────────────────────────────────────────────────
+
+describe('PartnerService', () => {
+  let repo: ReturnType<typeof createMockRepo>
+  let syncEngine: SyncEngine
+  let service: PartnerService
+
+  beforeEach(() => {
+    repo = createMockRepo()
+    syncEngine = createMockSyncEngine()
+    service = new PartnerService(repo, syncEngine, DEVICE_ID, EMPLOYEE_ID)
+  })
+
+  // ── submitApplication ──────────────────────────────────────────────────────
+
+  describe('submitApplication', () => {
+    it('creates a submitted application with correct fields', async () => {
+      const input: SubmitPartnerApplicationInput = {
+        applicantPersonId: PERSON_ID,
+        fullName: 'Alice Sales',
+        email: 'alice@example.com',
+        phone: '+254700000001',
+        country: 'KE',
+        motivation: 'I love selling',
+      }
+
+      const app = await service.submitApplication(input)
+
+      expect(app.status).toBe('submitted')
+      expect(app.applicantPersonId).toBe(PERSON_ID)
+      expect(app.fullName).toBe('Alice Sales')
+      expect(app.email).toBe('alice@example.com')
+      expect(app.phone).toBe('+254700000001')
+      expect(app.country).toBe('KE')
+      expect(app.motivation).toBe('I love selling')
+      expect(app.influencerId).toBeNull()
+      expect(app.reviewerUserId).toBeNull()
+      expect(app.reviewNotes).toBeNull()
+      expect(app.reviewedAt).toBeNull()
+      expect(app.submittedAt).not.toBeNull()
+      expect(app.version).toBe(1)
+    })
+
+    it('is idempotent — returns existing application for same person', async () => {
+      const input: SubmitPartnerApplicationInput = {
+        applicantPersonId: PERSON_ID,
+        fullName: 'Alice Sales',
+        email: 'alice@example.com',
+        phone: '+254700000001',
+        country: 'KE',
+      }
+
+      const first = await service.submitApplication(input)
+      const second = await service.submitApplication(input)
+
+      expect(first.id).toBe(second.id)
+      expect(repo.upsertApplication).toHaveBeenCalledTimes(1)
+    })
+
+    it('emits partner.application.created sync event', async () => {
+      const input: SubmitPartnerApplicationInput = {
+        applicantPersonId: PERSON_ID,
+        fullName: 'Bob Sales',
+        email: 'bob@example.com',
+        phone: '+254700000002',
+        country: 'KE',
+      }
+
+      await service.submitApplication(input)
+
+      expect(syncEngine.enqueue).toHaveBeenCalledTimes(1)
+      const event = (syncEngine.enqueue as ReturnType<typeof vi.fn>).mock.calls[0][0]
+      expect(event.entityKind).toBe('salespersonApplication')
+      expect(event.operation).toBe('create')
+    })
+  })
+
+  // ── approveApplication ────────────────────────────────────────────────────
+
+  describe('approveApplication', () => {
+    it('creates a PartnerApproval with approved status and salespersonProfileId', async () => {
+      // First submit an application
+      const submitInput: SubmitPartnerApplicationInput = {
