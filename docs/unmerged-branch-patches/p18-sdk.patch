-    'timestamp' in cb && typeof cb.timestamp === 'string'
-      ? cb.timestamp
-      : new Date().toISOString()
-  const mpesaReceiptNumber =
-    'mpesa_receipt_number' in cb && cb.mpesa_receipt_number
-      ? String(cb.mpesa_receipt_number)
