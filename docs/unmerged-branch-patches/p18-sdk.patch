+/**
+ * EnrollmentService — unit tests.
+ *
+ * Tests:
+ *   enrollBusiness — creates enrollment, idempotency by businessId
+ *   listEnrollmentsBySalesperson — business isolation
+ *   listEnrollmentsByInfluencer — influencer attribution
+ */
+
+import { describe, it, expect, vi, beforeEach } from 'vitest'
+import type {
+  BusinessId, SalespersonProfileId, InfluencerProfileId,
+  PackageId, CommissionRuleId, DeviceId, EmployeeId,
+} from '@soostori/core'
+
+import type {
+  BusinessEnrollment,
+  EnrollBusinessInput,
+} from '../src/types.js'
+import type { PartnerRepository } from '../src/repository.js'
+import type { SyncEngine } from '@soostori/contracts'
+
+import { EnrollmentService } from '../src/enrollment-service.js'
+
+// ── Mock implementations ───────────────────────────────────────────────────────
+
+function createMockRepo() {
+  const enrollments = new Map<string, BusinessEnrollment>()
+
+  return {
+    store: { enrollments },
+    upsertApplication: vi.fn(),
+    getApplication: vi.fn(),
+    listApplicationsByStatus: vi.fn(),
+    upsertApproval: vi.fn(),
+    getApprovalByApplication: vi.fn(),
+    upsertReferral: vi.fn(),
+    getReferralBySalesperson: vi.fn(),
+    upsertEnrollment: vi.fn(async (e: BusinessEnrollment) => {
+      enrollments.set(e.id, e)
+    }),
+    getEnrollment: vi.fn(async (id: string) => enrollments.get(id) ?? null),
+    getEnrollmentByBusiness: vi.fn(async (bid: BusinessId) => {
+      return Array.from(enrollments.values()).find(e => e.businessId === bid) ?? null
+    }),
+    listEnrollmentsBySalesperson: vi.fn(async (sid: SalespersonProfileId) => {
+      return Array.from(enrollments.values()).filter(e => e.salespersonProfileId === sid)
+    }),
+    listEnrollmentsByInfluencer: vi.fn(async (iid: InfluencerProfileId) => {
+      return Array.from(enrollments.values()).filter(e => e.influencerId === iid)
+    }),
+    upsertConversion: vi.fn(),
+    getConversion: vi.fn(),
+    listConversionsByEnrollment: vi.fn(),
+    upsertEarning: vi.fn(),
+    getEarningByIdempotencyKey: vi.fn(),
+    listEarningsBySalesperson: vi.fn(),
+    upsertInfluencerEarning: vi.fn(),
+    getInfluencerEarningByIdempotencyKey: vi.fn(),
+    listInfluencerEarningsByInfluencer: vi.fn(),
+  } satisfies PartnerRepository
+}
+
+function createMockSyncEngine() {
+  return {
+    enqueue: vi.fn(async () => {}),
+  } satisfies unknown as SyncEngine
+}
+
+// ── Test helpers ───────────────────────────────────────────────────────────────
+
+const DEVICE_ID = 'dev-001' as DeviceId
+const EMPLOYEE_ID = 'emp-001' as EmployeeId
+const BUSINESS_ID = 'biz-001' as BusinessId
+const SALESPERSON_PROFILE_ID = 'sp-001' as SalespersonProfileId
+const INFLUENCER_PROFILE_ID = 'inf-001' as InfluencerProfileId
+const PACKAGE_ID = 'pkg-001' as PackageId
+const COMMISSION_RULE_ID = 'cr-001' as CommissionRuleId
+
+// ── Tests ──────────────────────────────────────────────────────────────────────
+
+describe('EnrollmentService', () => {
+  let repo: ReturnType<typeof createMockRepo>
+  let syncEngine: SyncEngine
+  let service: EnrollmentService
+
+  beforeEach(() => {
+    repo = createMockRepo()
+    syncEngine = createMockSyncEngine()
+    service = new EnrollmentService(repo, syncEngine, DEVICE_ID, EMPLOYEE_ID)
+  })
+
+  describe('enrollBusiness', () => {
+    it('creates an active enrollment with all fields', async () => {
+      const input: EnrollBusinessInput = {
+        businessId: BUSINESS_ID,
+        salespersonProfileId: SALESPERSON_PROFILE_ID,
+        influencerId: INFLUENCER_PROFILE_ID,
+        packageId: PACKAGE_ID,
+        commissionRuleId: COMMISSION_RULE_ID,
+      }
+
+      const enrollment = await service.enrollBusiness(input)
+
+      expect(enrollment.businessId).toBe(BUSINESS_ID)
+      expect(enrollment.salespersonProfileId).toBe(SALESPERSON_PROFILE_ID)
+      expect(enrollment.influencerId).toBe(INFLUENCER_PROFILE_ID)
+      expect(enrollment.packageId).toBe(PACKAGE_ID)
+      expect(enrollment.commissionRuleId).toBe(COMMISSION_RULE_ID)
+      expect(enrollment.status).toBe('active')
+      expect(enrollment.enrolledAt).not.toBeNull()
+      expect(enrollment.terminatedAt).toBeNull()
+      expect(enrollment.version).toBe(1)
+    })
+
+    it('throws if business is already enrolled (idempotency guard)', async () => {
+      const input: EnrollBusinessInput = {
+        businessId: BUSINESS_ID,
+        salespersonProfileId: SALESPERSON_PROFILE_ID,
+        influencerId: INFLUENCER_PROFILE_ID,
+      }
+
+      await service.enrollBusiness(input)
+      await expect(service.enrollBusiness(input)).rejects.toThrow(
+        `Business ${BUSINESS_ID} is already enrolled`,
+      )
+    })
+
+    it('emits business.enrollment.created sync event', async () => {
+      const input: EnrollBusinessInput = {
+        businessId: BUSINESS_ID,
+        salespersonProfileId: SALESPERSON_PROFILE_ID,
+      }
+
+      await service.enrollBusiness(input)
+
+      expect(syncEngine.enqueue).toHaveBeenCalledTimes(1)
+      const event = (syncEngine.enqueue as ReturnType<typeof vi.fn>).mock.calls[0][0]
+      expect(event.entityKind).toBe('businessEnrollment')
+      expect(event.operation).toBe('create')
+    })
+  })
+
+  describe('listEnrollmentsBySalesperson', () => {
+    it('returns only enrollments for the given salesperson', async () => {
+      const anotherBusiness = 'biz-002' as BusinessId
+      const anotherSalesperson = 'sp-002' as SalespersonProfileId
+
+      await service.enrollBusiness({
+        businessId: BUSINESS_ID,
+        salespersonProfileId: SALESPERSON_PROFILE_ID,
+      })
+      await service.enrollBusiness({
+        businessId: anotherBusiness,
+        salespersonProfileId: anotherSalesperson,
+      })
+
+      const results = await service.listEnrollmentsBySalesperson(SALESPERSON_PROFILE_ID)
+
+      expect(results).toHaveLength(1)
+      expect(results[0].businessId).toBe(BUSINESS_ID)
+    })
+
+    it('returns empty array when salesperson has no enrollments', async () => {
+      const results = await service.listEnrollmentsBySalesperson(SALESPERSON_PROFILE_ID)
+      expect(results).toHaveLength(0)
+    })
+  })
+
+  describe('listEnrollmentsByInfluencer', () => {
+    it('returns only enrollments attributed to the influencer', async () => {
+      const enrolledWithInfluencer = await service.enrollBusiness({
+        businessId: BUSINESS_ID,
+        salespersonProfileId: SALESPERSON_PROFILE_ID,
+        influencerId: INFLUENCER_PROFILE_ID,
+      })
+
+      await service.enrollBusiness({
+        businessId: 'biz-002' as BusinessId,
+        salespersonProfileId: 'sp-002' as SalespersonProfileId,
+        // no influencerId
+      })
+
+      const results = await service.listEnrollmentsByInfluencer(INFLUENCER_PROFILE_ID)
+
+      expect(results).toHaveLength(1)
+      expect(results[0].businessId).toBe(BUSINESS_ID)
+    })
+  })
+})
