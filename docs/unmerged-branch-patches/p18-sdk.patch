-      meetingStatus: 'completed',
-      // meetingDate and activeAt intentionally NOT modified.
-      updatedAt: now,
-      version: profile.version + 1,
-    }
-
-    await this.repo.upsertSalespersonProfile(updated)
-
-    await this.emit(SALESPERSON_MEETING_COMPLETED, {
