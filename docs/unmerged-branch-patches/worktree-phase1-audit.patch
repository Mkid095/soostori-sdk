-  it('below base (amount < 600): company + salesperson = 600 (company absorbs shortfall)', () => {
-    ;[0, 1, 100, 599].forEach(amount => {
-      const r = svc().calculateSplit(amount as any)
-      expect(r.companyShare + r.salespersonShare).toBe(600)
-    })
-  })
-})
