+      expect(syncEngine.enqueue).toHaveBeenCalledTimes(2) // submit + approve
+      const events = (syncEngine.enqueue as ReturnType<typeof vi.fn>).mock.calls
+      const approvalEvent = events[1][0]
+      expect(approvalEvent.entityKind).toBe('salespersonApplication')
+      expect(approvalEvent.operation).toBe('create')
