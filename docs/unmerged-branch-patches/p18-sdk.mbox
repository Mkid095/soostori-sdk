+} from '../src/types.js'
+import type { PartnerRepository } from '../src/repository.js'
+import type { SyncEngine } from '@soostori/contracts'
+
+import { PartnerService } from '../src/partner-service.js'
+
+// ── Mock implementations ───────────────────────────────────────────────────────
+
+function createMockRepo() {
+  const store = {
+    applications: new Map<string, PartnerApplication>(),
+    approvals: new Map<string, PartnerApproval>(),
+    referrals: new Map<SalespersonProfileId, PartnerReferral>(),
+  }
+
+  return {
+    store,
+    upsertApplication: vi.fn(async (app: PartnerApplication) => {
+      store.applications.set(app.id, app)
+    }),
+    getApplication: vi.fn(async (id: SalespersonApplicationId) => {
+      return store.applications.get(id as string) ?? null
+    }),
+    listApplicationsByStatus: vi.fn(async (_status: PartnerApplication['status']) => {
+      return Array.from(store.applications.values())
+    }),
+    upsertApproval: vi.fn(async (approval: PartnerApproval) => {
+      store.approvals.set(approval.id, approval)
+    }),
+    getApprovalByApplication: vi.fn(async (applicationId: SalespersonApplicationId) => {
+      return Array.from(store.approvals.values()).find(a => a.applicationId === applicationId) ?? null
+    }),
+    upsertReferral: vi.fn(async (referral: PartnerReferral) => {
+      store.referrals.set(referral.salespersonProfileId, referral)
+    }),
+    getReferralBySalesperson: vi.fn(async (salespersonId: SalespersonProfileId) => {
+      return store.referrals.get(salespersonId) ?? null
+    }),
+    upsertEnrollment: vi.fn(),
+    getEnrollmentByBusiness: vi.fn(),
+    listEnrollmentsBySalesperson: vi.fn(),
+    listEnrollmentsByInfluencer: vi.fn(),
+    upsertConversion: vi.fn(),
+    getConversion: vi.fn(),
+    listConversionsByEnrollment: vi.fn(),
+    upsertEarning: vi.fn(),
+    getEarningByIdempotencyKey: vi.fn(),
+    listEarningsBySalesperson: vi.fn(),
+    upsertInfluencerEarning: vi.fn(),
+    getInfluencerEarningByIdempotencyKey: vi.fn(),
+    listInfluencerEarningsByInfluencer: vi.fn(),
+  } satisfies PartnerRepository
+}
+
+function createMockSyncEngine() {
+  return {
+    enqueue: vi.fn(async () => {}),
+  } satisfies unknown as SyncEngine
+}
+
+// ── Test helpers ───────────────────────────────────────────────────────────────
+
+const DEVICE_ID = 'dev-001' as DeviceId
+const EMPLOYEE_ID = 'emp-001' as EmployeeId
