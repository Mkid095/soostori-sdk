+++ b/packages/partners/src/types.ts
@@ -0,0 +1,245 @@
+/**
+ * Canonical partner / salesperson / influencer contract types.
+ *
+ * Acceptance chain:
+ *   Influencer recruits Salesperson
+ *   → Salesperson applies / gets approved
+ *   → Salesperson enrolls Business
+ *   → Qualifying subscription / payment event (Conversion)
+ *   → CommissionEarning recorded (idempotent per conversionId + earningType)
+ *   → InfluencerEarning recorded (50 flat per conversion)
+ *
+ * Invariants (proven by CommissionEarningService):
+ *   1. Attribution chain (Influencer → Salesperson → Business) is immutable once set.
+ *   2. One Conversion cannot produce duplicate commissions (idempotency key).
+ *   3. Commission fires ONLY on qualifying subscription/payment — NOT on lead assignment.
+ *   4. Commission uses canonical Phase 06 formula — no duplication across platforms.
+ *   5. Business isolation: partner sees only their enrolled businesses and earnings.
+ */
+
+import type {
+  BusinessId, PersonId, SalespersonApplicationId,
+  SalespersonProfileId, InfluencerProfileId, PackageId,
+  CommissionRuleId, CommissionLedgerId,
+  ISO8601, Money, IdempotencyKey,
+} from '@soostori/core'
+
+// ── PartnerApplication ────────────────────────────────────────────────────────
+
+export type PartnerApplicationStatus =
+  | 'draft'
+  | 'submitted'
+  | 'under_review'
+  | 'approved'
+  | 'rejected'
+  | 'withdrawn'
+
+/**
+ * PartnerApplication — submitted by a salesperson or influencer prospect.
+ *
+ * Lifecycle: draft → submitted → under_review ↔ documents_required
+ *          → approved | rejected | withdrawn.
+ */
+export interface PartnerApplication {
+  id: SalespersonApplicationId
+  applicantPersonId: PersonId
+  fullName: string
+  email: string
+  phone: string
+  country: string
+  idDocumentRef?: string | null
+  photoRef?: string | null
+  motivation?: string | null
+  status: PartnerApplicationStatus
+  /** Recruiting influencer (set by admin at approval time). */
+  influencerId?: InfluencerProfileId | null
+  reviewerUserId?: string | null
+  reviewNotes?: string | null
+  reviewedAt?: ISO8601 | null
+  submittedAt?: ISO8601 | null
+  createdAt: ISO8601
+  updatedAt: ISO8601
+  version: number
+}
+
+// ── PartnerApproval ──────────────────────────────────────────────────────────
+
+export type ApprovalStatus = 'approved' | 'rejected'
+
+export interface PartnerApproval {
+  id: string
+  applicationId: SalespersonApplicationId
+  approvedBy: string
+  status: ApprovalStatus
+  /** Assigned salesperson profile (set when approved). */
+  salespersonProfileId?: SalespersonProfileId | null
+  /** Recruiting influencer (optional — set at approval time). */
+  influencerId?: InfluencerProfileId | null
+  reviewNotes?: string | null
+  createdAt: ISO8601
+}
+
+// ── PartnerReferral ───────────────────────────────────────────────────────────
+
+/**
+ * PartnerReferral — tracks Influencer → Salesperson attribution.
+ *
+ * IMMUTABLE once set. The chain Influencer → Salesperson cannot be
+ * reassigned after creation.
+ */
+export interface PartnerReferral {
+  id: string
+  influencerId: InfluencerProfileId
+  salespersonProfileId: SalespersonProfileId
+  /** The business that was enrolled by the salesperson (for this referral). */
+  businessId?: BusinessId | null
+  createdAt: ISO8601
+}
+
+// ── BusinessEnrollment ───────────────────────────────────────────────────────
+
+export type EnrollmentStatus = 'active' | 'suspended' | 'terminated'
+
+/**
+ * BusinessEnrollment — a salesperson enrolls a business under their referral.
+ *
+ * The business is associated with the salesperson's CommissionRule, which
+ * drives the commission split defined in Phase 06.
+ */
+export interface BusinessEnrollment {
+  id: string
+  businessId: BusinessId
+  salespersonProfileId: SalespersonProfileId
+  influencerId?: InfluencerProfileId | null
+  packageId?: PackageId | null
+  commissionRuleId?: CommissionRuleId | null
+  status: EnrollmentStatus
+  enrolledAt: ISO8601
+  terminatedAt?: ISO8601 | null
+  createdAt: ISO8601
+  updatedAt: ISO8601
+  version: number
+}
+
+// ── Conversion ────────────────────────────────────────────────────────────────
+
+export type ConversionStatus = 'qualified' | 'cancelled'
+
+/**
+ * Conversion — a qualifying subscription/payment event that triggers commission.
+ *
+ * NOT emitted on lead assignment. Fires ONLY when:
+ *   - A subscription payment is confirmed (first or recurring)
+ *   - The business is enrolled and has an active commission rule
+ */
+export interface Conversion {
+  id: string
+  enrollmentId: string
+  businessId: BusinessId
+  salespersonProfileId: SalespersonProfileId
+  influencerId?: InfluencerProfileId | null
+  commissionRuleId: CommissionRuleId
+  packageAmount: Money
+  status: ConversionStatus
+  qualifiedAt: ISO8601 | null
+  cancelledAt?: ISO8601 | null
+  createdAt: ISO8601
+  version: number
+  /** Idempotency: `conversion:${enrollmentId}` */
+  idempotencyKey: IdempotencyKey
+}
+
+// ── CommissionEarning ────────────────────────────────────────────────────────
+
+export type EarningType = 'salesperson' | 'influencer'
+
+/**
+ * CommissionEarning — immutable commission record for the salesperson.
+ *
+ * Idempotency key: conversionId + earningType ('salesperson')
+ * Created ONCE per qualifying Conversion.
+ *
+ * Uses the Phase 06 canonical formula:
+ *   salespersonShare = 100 + 75% × max(0, amount − 600)
+ */
+export interface CommissionEarning {
+  id: string
+  salespersonId: SalespersonProfileId
+  businessId: BusinessId
+  conversionId: string
+  commissionRuleId: CommissionRuleId
+  /** Idempotency: conversionId + '#salesperson' */
+  idempotencyKey: IdempotencyKey
+  amount: Money
+  currency: string
+  periodMonth: string
+  createdAt: ISO8601
+}
+
+// ── InfluencerEarning ─────────────────────────────────────────────────────────
+
+/**
+ * InfluencerEarning — immutable influencer commission record.
+ *
+ * Chain: Conversion → CommissionEarning → InfluencerEarning
+ *
+ * Idempotency key: conversionId + '#influencer'
+ * Amount: 50 flat per qualifying Conversion (paid BY COMPANY).
+ */
+export interface InfluencerEarning {
+  id: string
+  influencerId: InfluencerProfileId
+  commissionEarningId: string
+  conversionId: string
+  /** Idempotency: conversionId + '#influencer' */
+  idempotencyKey: IdempotencyKey
+  /** Always 50 KES — paid by company, not deducted from client payment. */
+  amount: Money
+  currency: string
+  periodMonth: string
+  createdAt: ISO8601
+}
+
+// ── Input types ───────────────────────────────────────────────────────────────
+
+export interface SubmitPartnerApplicationInput {
+  applicantPersonId: PersonId
+  fullName: string
+  email: string
+  phone: string
+  country: string
+  idDocumentRef?: string | null
+  photoRef?: string | null
+  motivation?: string | null
+}
+
+export interface ApprovePartnerApplicationInput {
+  applicationId: SalespersonApplicationId
+  approvedBy: string
+  status: ApprovalStatus
+  /** Recruiting influencer (optional). */
+  influencerId?: InfluencerProfileId | null
+  reviewNotes?: string | null
+}
+
+export interface CreateReferralInput {
+  influencerId: InfluencerProfileId
+  salespersonProfileId: SalespersonProfileId
+}
+
+export interface EnrollBusinessInput {
+  businessId: BusinessId
+  salespersonProfileId: SalespersonProfileId
+  influencerId?: InfluencerProfileId | null
+  packageId?: PackageId | null
+  commissionRuleId?: CommissionRuleId | null
+}
+
+export interface RecordConversionInput {
+  enrollmentId: string
+  businessId: BusinessId
+  salespersonProfileId: SalespersonProfileId
+  influencerId?: InfluencerProfileId | null
+  commissionRuleId: CommissionRuleId
+  packageAmount: Money
+}
diff --git a/packages/partners/test/CommissionEarningService.test.ts b/packages/partners/test/CommissionEarningService.test.ts
