+/**
+ * PartnerService — manages applications, approvals, and referrals.
+ *
+ * All mutations emit sync events via syncEngine.enqueue().
+ * The attribution chain (Influencer → Salesperson) is immutable once set.
+ */
+
+import type {
+  PersonId, SalespersonApplicationId,
+  SalespersonProfileId, InfluencerProfileId,
+  DeviceId, EmployeeId, ISO8601,
+} from '@soostori/core'
+import { newId, asIdempotencyKey } from '@soostori/core'
+import type { SyncEngine, SyncEvent, EntityKind } from '@soostori/contracts'
+
+import type {
+  PartnerApplication,
+  PartnerApproval,
+  PartnerReferral,
+  SubmitPartnerApplicationInput,
+  ApprovePartnerApplicationInput,
+  CreateReferralInput,
+} from './types.js'
+import type { PartnerRepository } from './repository.js'
+import {
+  PARTNER_APPLICATION_CREATED,
+  PARTNER_APPROVAL_CREATED,
+  PARTNER_REFERRAL_CREATED,
+} from './events.js'
+
+export class PartnerService {
+  constructor(
+    private readonly repo: PartnerRepository,
+    private readonly syncEngine: SyncEngine,
+    private readonly deviceId: DeviceId,
+    private readonly employeeId: EmployeeId,
+  ) {}
+
+  // ── Application ─────────────────────────────────────────────────────────────
+
+  async submitApplication(
+    input: SubmitPartnerApplicationInput,
+  ): Promise<PartnerApplication> {
+    const existing = await this.repo.getApplication(input.applicantPersonId as unknown as SalespersonApplicationId)
+    if (existing) return existing
+
+    const now = new Date().toISOString() as ISO8601
+    const app: PartnerApplication = {
+      id: newId() as SalespersonApplicationId,
+      applicantPersonId: input.applicantPersonId,
+      fullName: input.fullName,
+      email: input.email,
+      phone: input.phone,
+      country: input.country,
+      idDocumentRef: input.idDocumentRef ?? null,
+      photoRef: input.photoRef ?? null,
+      motivation: input.motivation ?? null,
+      status: 'submitted',
+      influencerId: null,
+      reviewerUserId: null,
+      reviewNotes: null,
+      reviewedAt: null,
+      submittedAt: now,
+      createdAt: now,
+      updatedAt: now,
+      version: 1,
+    }
+
+    await this.repo.upsertApplication(app)
+    await this.emit(PARTNER_APPLICATION_CREATED, app, 'create', 'salespersonApplication')
+    return app
+  }
+
+  async getApplication(id: SalespersonApplicationId): Promise<PartnerApplication | null> {
+    return this.repo.getApplication(id)
+  }
+
+  async listApplicationsByStatus(
+    status: PartnerApplication['status'],
+  ): Promise<PartnerApplication[]> {
+    return this.repo.listApplicationsByStatus(status)
+  }
+
+  // ── Approval ─────────────────────────────────────────────────────────────────
+
+  async approveApplication(
+    input: ApprovePartnerApplicationInput,
+  ): Promise<PartnerApproval> {
+    const app = await this.repo.getApplication(input.applicationId)
+    if (!app) throw new Error(`Application ${input.applicationId} not found`)
+
+    const status: ApprovalStatus = input.status
+    const now = new Date().toISOString() as ISO8601
+
+    const approval: PartnerApproval = {
+      id: newId(),
+      applicationId: input.applicationId,
+      approvedBy: input.approvedBy,
+      status,
+      salespersonProfileId: status === 'approved' ? (newId() as SalespersonProfileId) : null,
+      influencerId: input.influencerId ?? null,
+      reviewNotes: input.reviewNotes ?? null,
+      createdAt: now,
+    }
+
+    await this.repo.upsertApproval(approval)
+
+    if (status === 'approved') {
+      const updatedApp: PartnerApplication = {
+        ...app,
+        status: 'approved',
+        influencerId: input.influencerId ?? null,
+        reviewerUserId: input.approvedBy,
+        reviewNotes: input.reviewNotes ?? null,
+        reviewedAt: now,
+        updatedAt: now,
+        version: app.version + 1,
+      }
+      await this.repo.upsertApplication(updatedApp)
+    }
+
+    await this.emit(PARTNER_APPROVAL_CREATED, approval, 'create', 'salespersonApplication')
+    return approval
+  }
+
+  async getApprovalByApplication(
+    applicationId: SalespersonApplicationId,
+  ): Promise<PartnerApproval | null> {
+    return this.repo.getApprovalByApplication(applicationId)
+  }
+
+  // ── Referral ────────────────────────────────────────────────────────────────
+
+  /**
+   * Create an immutable Influencer → Salesperson attribution link.
+   * IMMUTABLE: once set, the referral cannot be changed.
+   */
+  async createReferral(input: CreateReferralInput): Promise<PartnerReferral> {
+    const existing = await this.repo.getReferralBySalesperson(input.salespersonProfileId)
+    if (existing) {
+      throw new Error('Salesperson already has a referral — attribution is immutable')
+    }
+
+    const now = new Date().toISOString() as ISO8601
+    const referral: PartnerReferral = {
+      id: newId(),
+      influencerId: input.influencerId,
+      salespersonProfileId: input.salespersonProfileId,
+      businessId: null,
+      createdAt: now,
+    }
+
+    await this.repo.upsertReferral(referral)
+    await this.emit(PARTNER_REFERRAL_CREATED, referral, 'create', 'salespersonProfile')
+    return referral
+  }
+
+  async getReferralBySalesperson(
+    salespersonId: SalespersonProfileId,
+  ): Promise<PartnerReferral | null> {
+    return this.repo.getReferralBySalesperson(salespersonId)
+  }
+
+  // ── emit ────────────────────────────────────────────────────────────────────
+
+  private async emit(
+    eventType: string,
+    entity: unknown,
+    syncOp: SyncEvent['operation'],
+    entityKind: EntityKind,
+  ): Promise<void> {
+    const entityId = (entity as { id: string }).id
+    const event: SyncEvent = {
+      id: newId() as SyncEvent['id'],
+      idempotencyKey: asIdempotencyKey(`${entityId}:${eventType}`),
+      businessId: '' as import('@soostori/core').BusinessId,
+      entityKind,
+      entityId,
+      operation: syncOp,
+      originatingDeviceId: this.deviceId,
+      originatingEmployeeId: this.employeeId,
+      clientSequence: Date.now(),
+      clientCreatedAt: new Date().toISOString(),
+      entityVersion: 1,
+      payload: entity as Record<string, unknown>,
+      state: 'pending',
+    }
+    await this.syncEngine.enqueue(event)
+  }
+}
