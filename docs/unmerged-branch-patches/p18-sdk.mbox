+/**
+ * EnrollmentService — unit tests.
+ *
+ * Tests:
+ *   enrollBusiness — creates enrollment, idempotency by businessId
+ *   listEnrollmentsBySalesperson — business isolation
+ *   listEnrollmentsByInfluencer — influencer attribution
+ */
+
+import { describe, it, expect, vi, beforeEach } from 'vitest'
+import type {
+  BusinessId, SalespersonProfileId, InfluencerProfileId,
+  PackageId, CommissionRuleId, DeviceId, EmployeeId,
+} from '@soostori/core'
+
+import type {
+  BusinessEnrollment,
+  EnrollBusinessInput,
+} from '../src/types.js'
+import type { PartnerRepository } from '../src/repository.js'
+import type { SyncEngine } from '@soostori/contracts'
+
+import { EnrollmentService } from '../src/enrollment-service.js'
+
+// ── Mock implementations ───────────────────────────────────────────────────────
+
+function createMockRepo() {
+  const enrollments = new Map<string, BusinessEnrollment>()
+
+  return {
+    store: { enrollments },
+    upsertApplication: vi.fn(),
+    getApplication: vi.fn(),
+    listApplicationsByStatus: vi.fn(),
+    upsertApproval: vi.fn(),
+    getApprovalByApplication: vi.fn(),
+    upsertReferral: vi.fn(),
+    getReferralBySalesperson: vi.fn(),
+    upsertEnrollment: vi.fn(async (e: BusinessEnrollment) => {
+      enrollments.set(e.id, e)
+    }),
+    getEnrollment: vi.fn(async (id: string) => enrollments.get(id) ?? null),
+    getEnrollmentByBusiness: vi.fn(async (bid: BusinessId) => {
+      return Array.from(enrollments.values()).find(e => e.businessId === bid) ?? null
+    }),
+    listEnrollmentsBySalesperson: vi.fn(async (sid: SalespersonProfileId) => {
+      return Array.from(enrollments.values()).filter(e => e.salespersonProfileId === sid)
+    }),
+    listEnrollmentsByInfluencer: vi.fn(async (iid: InfluencerProfileId) => {
+      return Array.from(enrollments.values()).filter(e => e.influencerId === iid)
+    }),
+    upsertConversion: vi.fn(),
+    getConversion: vi.fn(),
+    listConversionsByEnrollment: vi.fn(),
+    upsertEarning: vi.fn(),
+    getEarningByIdempotencyKey: vi.fn(),
+    listEarningsBySalesperson: vi.fn(),
+    upsertInfluencerEarning: vi.fn(),
+    getInfluencerEarningByIdempotencyKey: vi.fn(),
+    listInfluencerEarningsByInfluencer: vi.fn(),
+  } satisfies PartnerRepository
+}
+
+function createMockSyncEngine() {
+  return {
+    enqueue: vi.fn(async () => {}),
+  } satisfies unknown as SyncEngine
+}
+
+// ── Test helpers ───────────────────────────────────────────────────────────────
+
+const DEVICE_ID = 'dev-001' as DeviceId
+const EMPLOYEE_ID = 'emp-001' as EmployeeId
+const BUSINESS_ID = 'biz-001' as BusinessId
+const SALESPERSON_PROFILE_ID = 'sp-001' as SalespersonProfileId
+const INFLUENCER_PROFILE_ID = 'inf-001' as InfluencerProfileId
+const PACKAGE_ID = 'pkg-001' as PackageId
+const COMMISSION_RULE_ID = 'cr-001' as CommissionRuleId
+
+// ── Tests ──────────────────────────────────────────────────────────────────────
+
