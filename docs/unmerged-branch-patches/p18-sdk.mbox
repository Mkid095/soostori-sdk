+/**
+ * PartnerRepository — data access contract for partner operations.
+ *
+ * Implement this interface to plug in FIDScript, SQLite, or in-memory storage.
+ */
+
+import type {
+  BusinessId, SalespersonApplicationId,
+  SalespersonProfileId, InfluencerProfileId,
+} from '@soostori/core'
+import type {
+  PartnerApplication,
+  PartnerApproval,
+  PartnerReferral,
+  BusinessEnrollment,
+  Conversion,
+  CommissionEarning,
+  InfluencerEarning,
+} from './types.js'
+
+export interface PartnerRepository {
+  // ── Application ──────────────────────────────────────────────────────────
+  upsertApplication(app: PartnerApplication): Promise<void>
+  getApplication(id: SalespersonApplicationId): Promise<PartnerApplication | null>
+  listApplicationsByStatus(
+    status: PartnerApplication['status'],
+  ): Promise<PartnerApplication[]>
+
+  // ── Approval ───────────────────────────────────────────────────────────────
+  upsertApproval(approval: PartnerApproval): Promise<void>
+  getApprovalByApplication(
+    applicationId: SalespersonApplicationId,
+  ): Promise<PartnerApproval | null>
+
+  // ── Referral (immutable) ─────────────────────────────────────────────────
+  upsertReferral(referral: PartnerReferral): Promise<void>
+  getReferralBySalesperson(
+    salespersonId: SalespersonProfileId,
+  ): Promise<PartnerReferral | null>
+
+  // ── Enrollment ─────────────────────────────────────────────────────────────
+  upsertEnrollment(enrollment: BusinessEnrollment): Promise<void>
+  getEnrollment(id: string): Promise<BusinessEnrollment | null>
+  getEnrollmentByBusiness(businessId: BusinessId): Promise<BusinessEnrollment | null>
+  listEnrollmentsBySalesperson(
+    salespersonId: SalespersonProfileId,
+  ): Promise<BusinessEnrollment[]>
+  listEnrollmentsByInfluencer(
+    influencerId: InfluencerProfileId,
+  ): Promise<BusinessEnrollment[]>
+
+  // ── Conversion ────────────────────────────────────────────────────────────
+  upsertConversion(conversion: Conversion): Promise<void>
+  getConversion(id: string): Promise<Conversion | null>
+  getConversionByIdempotencyKey(key: string): Promise<Conversion | null>
+  listConversionsByEnrollment(enrollmentId: string): Promise<Conversion[]>
+
+  // ── Commission Earning ────────────────────────────────────────────────────
+  upsertEarning(earning: CommissionEarning): Promise<void>
+  getEarningByIdempotencyKey(key: string): Promise<CommissionEarning | null>
+  listEarningsBySalesperson(
+    salespersonId: SalespersonProfileId,
+  ): Promise<CommissionEarning[]>
+
+  // ── Influencer Earning ────────────────────────────────────────────────────
+  upsertInfluencerEarning(earning: InfluencerEarning): Promise<void>
+  getInfluencerEarningByIdempotencyKey(key: string): Promise<InfluencerEarning | null>
+  listInfluencerEarningsByInfluencer(
+    influencerId: InfluencerProfileId,
+  ): Promise<InfluencerEarning[]>
+}
