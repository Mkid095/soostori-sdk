@@ -0,0 +1,254 @@
+/**
+ * CommissionEarningService — generates commission earnings with idempotency.
+ *
+ * Commercial invariants (proven here):
+ *   1. Attribution chain (Influencer → Salesperson → Business) is immutable once set.
+ *   2. One Conversion cannot create duplicate commissions — idempotency by conversionId + earningType.
+ *   3. Commission fires ONLY on qualifying subscription/payment — NOT on lead assignment.
+ *   4. Commission calculation uses Phase 06 canonical formula.
+ *   5. Business isolation: partner sees only their enrolled businesses and earnings.
+ *
+ * Phase 06 formula:
+ *   companyShare     = 500 + 25% × max(0, amount − 600)
+ *   salespersonShare = 100 + 75% × max(0, amount − 600)
+ *   influencerShare  = 50 flat (paid BY COMPANY, not from client payment)
+ *   Min qualifying amount: 600 KES
+ */
+
+import type {
+  BusinessId, SalespersonProfileId, InfluencerProfileId,
+  DeviceId, EmployeeId, CommissionRuleId,
+  ISO8601, Money, IdempotencyKey,
+} from '@soostori/core'
+import { newId, asIdempotencyKey } from '@soostori/core'
+import type { SyncEngine, SyncEvent, EntityKind } from '@soostori/contracts'
+
+import type {
+  Conversion,
+  CommissionEarning,
+  InfluencerEarning,
+  RecordConversionInput,
+} from './types.js'
+import type { PartnerRepository } from './repository.js'
+import {
+  CONVERSION_QUALIFIED,
+  COMMISSION_EARNING_CREATED,
+  INFLUENCER_EARNING_CREATED,
+} from './events.js'
+
+// Phase 06 constants
+const MIN_QUALIFYING_AMOUNT = 600 as Money
+
+function calculateSalespersonShare(amount: Money): Money {
+  const excess = Math.max(0, amount - MIN_QUALIFYING_AMOUNT)
+  return (100 + 0.75 * excess) as Money
+}
+
+function periodMonth(now: Date): string {
+  const y = now.getUTCFullYear()
+  const m = String(now.getUTCMonth() + 1).padStart(2, '0')
+  return `${y}-${m}`
+}
+
+export class CommissionEarningService {
+  constructor(
+    private readonly repo: PartnerRepository,
+    private readonly syncEngine: SyncEngine,
+    private readonly deviceId: DeviceId,
+    private readonly employeeId: EmployeeId,
+  ) {}
+
+  /**
+   * Record a qualifying conversion and generate commission earnings.
+   *
+   * Idempotent: if a Conversion with the same enrollmentId already exists,
+   * returns it without creating a duplicate (no duplicate earnings either).
+   *
+   * Fires ONLY on qualifying subscription/payment — NOT on lead assignment.
+   */
+  async recordConversion(input: RecordConversionInput): Promise<{
+    conversion: Conversion
+    earning: CommissionEarning
+    influencerEarning?: InfluencerEarning
+  }> {
+    const conversionKey = asIdempotencyKey(`conversion:${input.enrollmentId}`)
+
+    // Idempotency: return existing conversion + earnings if already recorded
+    const existingConversion = await this.repo.getConversionByIdempotencyKey(conversionKey)
+    if (existingConversion) {
+      const existingEarning = await this.repo.getEarningByIdempotencyKey(
+        asIdempotencyKey(`${input.enrollmentId}#salesperson`),
+      )
+      const existingInfluencerEarning = input.influencerId
+        ? await this.repo.getInfluencerEarningByIdempotencyKey(
+            asIdempotencyKey(`${input.enrollmentId}#influencer`),
+          )
+        : undefined
+
+      return {
+        conversion: existingConversion,
+        earning: existingEarning!,
+        influencerEarning: existingInfluencerEarning ?? undefined,
+      }
+    }
+
+    const now = new Date().toISOString() as ISO8601
+    const month = periodMonth(new Date())
+    const qualifies = input.packageAmount >= MIN_QUALIFYING_AMOUNT
+
+    // Persist the Conversion record
+    const conversion: Conversion = {
+      id: newId(),
+      enrollmentId: input.enrollmentId,
+      businessId: input.businessId,
+      salespersonProfileId: input.salespersonProfileId,
+      influencerId: input.influencerId ?? null,
+      commissionRuleId: input.commissionRuleId,
+      packageAmount: input.packageAmount,
+      status: qualifies ? 'qualified' : 'cancelled',
+      qualifiedAt: qualifies ? now : null as unknown as ISO8601,
+      cancelledAt: qualifies ? null : now as unknown as ISO8601,
+      createdAt: now,
+      version: 1,
+    }
+
+    await this.repo.upsertConversion(conversion)
+    await this.emitConversion(conversion)
+
+    // Calculate earnings only for qualifying amounts
+    const salespersonShare = qualifies ? calculateSalespersonShare(input.packageAmount) : (0 as Money)
+
+    // Create salesperson commission earning
+    const earning: CommissionEarning = {
+      id: newId(),
+      salespersonId: input.salespersonProfileId,
+      businessId: input.businessId,
+      conversionId: input.enrollmentId,
+      commissionRuleId: input.commissionRuleId,
+      idempotencyKey: asIdempotencyKey(`${input.enrollmentId}#salesperson`),
+      amount: salespersonShare,
+      currency: 'KES',
+      periodMonth: month,
+      createdAt: now,
+    }
+
+    await this.repo.upsertEarning(earning)
+    await this.emit(COMMISSION_EARNING_CREATED, earning, 'create', 'commissionEarning')
+
+    // Create influencer earning (50 flat, idempotent)
+    let influencerEarning: InfluencerEarning | undefined
+    if (input.influencerId && qualifies) {
+      const influencerKey = asIdempotencyKey(`${input.enrollmentId}#influencer`)
+      const existingInfluencer = await this.repo.getInfluencerEarningByIdempotencyKey(influencerKey)
+      if (!existingInfluencer) {
+        const ie: InfluencerEarning = {
+          id: newId(),
+          influencerId: input.influencerId,
+          commissionEarningId: earning.id,
+          conversionId: input.enrollmentId,
+          idempotencyKey: influencerKey,
+          amount: 50 as Money,
+          currency: 'KES',
+          periodMonth: month,
+          createdAt: now,
+        }
+        await this.repo.upsertInfluencerEarning(ie)
+        await this.emitInfluencer(INFLUENCER_EARNING_CREATED, ie, 'create', 'influencerEarning')
+        influencerEarning = ie
+      } else {
+        influencerEarning = existingInfluencer
+      }
+    }
+
+    return { conversion, earning, influencerEarning }
+  }
+
+  /**
+   * List all commission earnings for a salesperson (business-isolated).
+   */
+  async listEarningsBySalesperson(
+    salespersonId: SalespersonProfileId,
+  ): Promise<CommissionEarning[]> {
+    return this.repo.listEarningsBySalesperson(salespersonId)
+  }
+
+  /**
+   * List all influencer earnings for an influencer (business-isolated).
+   */
+  async listInfluencerEarningsByInfluencer(
+    influencerId: InfluencerProfileId,
+  ): Promise<InfluencerEarning[]> {
+    return this.repo.listInfluencerEarningsByInfluencer(influencerId)
+  }
+
+  // ── emit helpers ────────────────────────────────────────────────────────────
+
+  private async emitConversion(conversion: Conversion): Promise<void> {
+    const event: SyncEvent = {
+      id: newId() as SyncEvent['id'],
+      idempotencyKey: asIdempotencyKey(`conversion:${conversion.enrollmentId}:${CONVERSION_QUALIFIED}`),
+      businessId: conversion.businessId,
+      entityKind: 'conversion',
+      entityId: conversion.id,
+      operation: 'create',
+      originatingDeviceId: this.deviceId,
+      originatingEmployeeId: this.employeeId,
+      clientSequence: Date.now(),
+      clientCreatedAt: new Date().toISOString(),
+      entityVersion: 1,
+      payload: conversion as unknown as Record<string, unknown>,
+      state: 'pending',
+    }
+    await this.syncEngine.enqueue(event)
+  }
+
+  private async emit(
+    eventType: string,
+    entity: CommissionEarning | InfluencerEarning,
+    syncOp: SyncEvent['operation'],
+    entityKind: EntityKind,
+  ): Promise<void> {
+    const entityId = entity.id
+    const event: SyncEvent = {
+      id: newId() as SyncEvent['id'],
+      idempotencyKey: asIdempotencyKey(`${entityId}:${eventType}`),
+      businessId: (entity as CommissionEarning).businessId as BusinessId,
+      entityKind,
+      entityId,
+      operation: syncOp,
+      originatingDeviceId: this.deviceId,
+      originatingEmployeeId: this.employeeId,
+      clientSequence: Date.now(),
+      clientCreatedAt: new Date().toISOString(),
+      entityVersion: 1,
+      payload: entity as Record<string, unknown>,
+      state: 'pending',
+    }
+    await this.syncEngine.enqueue(event)
+  }
+
+  private async emitInfluencer(
+    eventType: string,
+    entity: InfluencerEarning,
+    syncOp: SyncEvent['operation'],
+    entityKind: EntityKind,
+  ): Promise<void> {
+    const entityId = entity.id
+    const event: SyncEvent = {
+      id: newId() as SyncEvent['id'],
+      idempotencyKey: asIdempotencyKey(`${entityId}:${eventType}`),
+      businessId: '' as BusinessId,
+      entityKind,
+      entityId,
+      operation: syncOp,
+      originatingDeviceId: this.deviceId,
+      originatingEmployeeId: this.employeeId,
+      clientSequence: Date.now(),
+      clientCreatedAt: new Date().toISOString(),
+      entityVersion: 1,
+      payload: entity as Record<string, unknown>,
+      state: 'pending',
+    }
+    await this.syncEngine.enqueue(event)
+  }
+}
