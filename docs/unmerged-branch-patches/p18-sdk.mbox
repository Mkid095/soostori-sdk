index 0000000..95d587f
--- /dev/null
+++ b/packages/partners/test/CommissionEarningService.test.ts
@@ -0,0 +1,364 @@
+/**
+ * CommissionEarningService — unit tests.
+ *
+ * Tests commercial invariants:
+ *   1. Attribution chain immutable (enrollment businessId set once)
+ *   2. Idempotency: same conversionId + earningType → no duplicate commission
+ *   3. Commission fires ONLY on qualifying subscription/payment (MIN 600 KES)
+ *   4. Commission uses canonical Phase 06 formula
+ *   5. Influencer earns 50 flat per qualifying conversion
+ *   6. Business isolation: listEarningsBySalesperson only returns own earnings
+ *
+ * Phase 06 formula:
+ *   salespersonShare = 100 + 75% × max(0, amount − 600)
+ *   influencerShare  = 50 flat
+ *   Min qualifying amount: 600 KES
+ */
+
+import { describe, it, expect, vi, beforeEach } from 'vitest'
+import type {
+  BusinessId, SalespersonProfileId, InfluencerProfileId,
+  CommissionRuleId, DeviceId, EmployeeId,
+} from '@soostori/core'
+
+import type {
+  CommissionEarning,
+  InfluencerEarning,
+  RecordConversionInput,
+} from '../src/types.js'
+import type { PartnerRepository } from '../src/repository.js'
+import type { SyncEngine } from '@soostori/contracts'
+
+import { CommissionEarningService } from '../src/commission-earning-service.js'
+
+// ── Mock implementations ───────────────────────────────────────────────────────
+
+function createMockRepo() {
+  const earnings: Map<string, CommissionEarning> = new Map()
+  const influencerEarnings: Map<string, InfluencerEarning> = new Map()
+  const conversions: Map<string, import('../src/types.js').Conversion> = new Map()
+
+  return {
+    store: { earnings, influencerEarnings, conversions },
+    upsertApplication: vi.fn(),
+    getApplication: vi.fn(),
+    listApplicationsByStatus: vi.fn(),
+    upsertApproval: vi.fn(),
+    getApprovalByApplication: vi.fn(),
+    upsertReferral: vi.fn(),
+    getReferralBySalesperson: vi.fn(),
+    upsertEnrollment: vi.fn(),
+    getEnrollmentByBusiness: vi.fn(),
+    listEnrollmentsBySalesperson: vi.fn(),
+    listEnrollmentsByInfluencer: vi.fn(),
+    upsertConversion: vi.fn(),
+    getConversion: vi.fn(),
+    getConversionByIdempotencyKey: vi.fn(async (key: string) => {
+      return conversions.get(key) ?? null
+    }),
+    listConversionsByEnrollment: vi.fn(),
+    upsertEarning: vi.fn(async (e: CommissionEarning) => {
+      earnings.set(e.idempotencyKey, e)
+    }),
+    getEarningByIdempotencyKey: vi.fn(async (key: string) => {
+      return earnings.get(key) ?? null
+    }),
+    listEarningsBySalesperson: vi.fn(async (sid: SalespersonProfileId) => {
+      return Array.from(earnings.values()).filter(e => e.salespersonId === sid)
+    }),
+    upsertInfluencerEarning: vi.fn(async (e: InfluencerEarning) => {
+      influencerEarnings.set(e.idempotencyKey, e)
+    }),
+    getInfluencerEarningByIdempotencyKey: vi.fn(async (key: string) => {
+      return influencerEarnings.get(key) ?? null
+    }),
+    listInfluencerEarningsByInfluencer: vi.fn(async (iid: InfluencerProfileId) => {
+      return Array.from(influencerEarnings.values()).filter(e => e.influencerId === iid)
+    }),
+  } satisfies PartnerRepository
+}
+
+function createMockSyncEngine() {
+  return {
+    enqueue: vi.fn(async () => {}),
+  } satisfies unknown as SyncEngine
+}
+
+// ── Test helpers ───────────────────────────────────────────────────────────────
+
+const DEVICE_ID = 'dev-001' as DeviceId
+const EMPLOYEE_ID = 'emp-001' as EmployeeId
+const BUSINESS_ID = 'biz-001' as BusinessId
+const SALESPERSON_PROFILE_ID = 'sp-001' as SalespersonProfileId
+const INFLUENCER_PROFILE_ID = 'inf-001' as InfluencerProfileId
+const COMMISSION_RULE_ID = 'cr-001' as CommissionRuleId
+const ENROLLMENT_ID = 'enr-001'
+
+function makeInput(amount: number, influencerId?: InfluencerProfileId): RecordConversionInput {
+  return {
+    enrollmentId: ENROLLMENT_ID,
+    businessId: BUSINESS_ID,
+    salespersonProfileId: SALESPERSON_PROFILE_ID,
+    influencerId: influencerId ?? INFLUENCER_PROFILE_ID,
+    commissionRuleId: COMMISSION_RULE_ID,
+    packageAmount: amount as import('@soostori/core').Money,
+  }
+}
+
+// ── Phase 06 formula reference ─────────────────────────────────────────────────
+// salespersonShare = 100 + 75% × max(0, amount − 600)
+function expectedSalesperson(amount: number): number {
+  return Math.max(0, 100 + 0.75 * Math.max(0, amount - 600))
+}
+
+// ── Tests ──────────────────────────────────────────────────────────────────────
+
+describe('CommissionEarningService', () => {
+  let repo: ReturnType<typeof createMockRepo>
+  let syncEngine: SyncEngine
+  let service: CommissionEarningService
+
+  beforeEach(() => {
+    repo = createMockRepo()
+    syncEngine = createMockSyncEngine()
+    service = new CommissionEarningService(repo, syncEngine, DEVICE_ID, EMPLOYEE_ID)
+  })
+
+  // ── Idempotency ───────────────────────────────────────────────────────────
+
+  describe('idempotency (Invariant 2)', () => {
+    it('returns existing earning without creating duplicate for same enrollmentId', async () => {
+      const input = makeInput(1000)
+
+      const first = await service.recordConversion(input)
+      const second = await service.recordConversion(input)
+
+      expect(first.conversion.id).toBe(second.conversion.id)
+      expect(first.earning.id).toBe(second.earning.id)
+      expect(first.conversion.idempotencyKey).toBe(second.conversion.idempotencyKey)
+      // Only one upsertEarning call
+      expect(repo.upsertEarning).toHaveBeenCalledTimes(1)
+    })
+
+    it('different earning types create separate earnings (salesperson vs influencer)', async () => {
+      const input = makeInput(1000)
+
+      const result = await service.recordConversion(input)
+
+      // First call should have created both salesperson + influencer earnings
+      expect(result.earning.amount).toBe(expectedSalesperson(1000))
+      expect(result.influencerEarning).not.toBeUndefined()
+      expect(result.influencerEarning?.amount).toBe(50)
+    })
+  })
+
+  // ── Minimum qualifying threshold ───────────────────────────────────────────
+
+  describe('minimum qualifying threshold (Invariant 3)', () => {
+    it('below 600 KES — returns zero-amount earning without error', async () => {
+      const input = makeInput(500)
+
+      const result = await service.recordConversion(input)
+
+      expect(result.earning.amount).toBe(0)
+      expect(result.influencerEarning).toBeUndefined()
+      expect(repo.upsertEarning).toHaveBeenCalled()
+    })
+
+    it('at exactly 600 KES — qualifies and pays salesperson 100 KES', async () => {
+      const input = makeInput(600)
+
+      const result = await service.recordConversion(input)
+
+      expect(result.earning.amount).toBe(100) // 100 + 75% × 0 = 100
+      expect(result.influencerEarning?.amount).toBe(50)
+    })
+
+    it('above 600 KES — applies excess to commission formula', async () => {
+      const input = makeInput(1200)
+      // 100 + 75% × (1200 − 600) = 100 + 450 = 550
+
+      const result = await service.recordConversion(input)
+
+      expect(result.earning.amount).toBe(550)
+      expect(result.influencerEarning?.amount).toBe(50)
+    })
+  })
+
+  // ── Phase 06 formula correctness (Invariant 4) ────────────────────────────
+
+  describe('Phase 06 canonical formula (Invariant 4)', () => {
+    const cases: Array<[amount: number, expectedSalesperson: number]> = [
+      [600,   100],   // 100 + 75% × 0 = 100
+      [700,   175],   // 100 + 75% × 100 = 175
+      [1000,  400],   // 100 + 75% × 400 = 400
+      [1200,  550],   // 100 + 75% × 600 = 550
+      [2000, 1150],   // 100 + 75% × 1400 = 1150
+    ]
+
+    cases.forEach(([amount, expected]) => {
+      it(`amount=${amount} → salesperson=${expected}`, async () => {
+        const input = makeInput(amount)
+        const result = await service.recordConversion(input)
+        expect(result.earning.amount).toBe(expected)
+      })
+    })
+
+    it('influencer always earns exactly 50 flat', async () => {
+      for (const [amount] of cases) {
+        const input = makeInput(amount)
+        const result = await service.recordConversion(input)
+        expect(result.influencerEarning?.amount).toBe(50)
+      }
+    })
+  })
+
