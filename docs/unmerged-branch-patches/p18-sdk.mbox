+        fullName: 'Alice Sales',
+        email: 'alice@example.com',
+        phone: '+254700000001',
+        country: 'KE',
+      })
+
+      await service.approveApplication({
+        applicationId: app.id,
+        approvedBy: 'admin-user-1',
+        status: 'approved',
