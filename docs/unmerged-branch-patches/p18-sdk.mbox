+/**
+ * EnrollmentService — manages business enrollments under a partner.
+ *
+ * The enrollment locks in the influencer attribution for a business.
+ * Emits sync events via syncEngine.enqueue().
+ */
+
+import type {
+  BusinessId, SalespersonProfileId, InfluencerProfileId,
+  PackageId, CommissionRuleId, DeviceId, EmployeeId, ISO8601,
+} from '@soostori/core'
+import { newId, asIdempotencyKey } from '@soostori/core'
+import type { SyncEngine, SyncEvent, EntityKind } from '@soostori/contracts'
+
+import type { BusinessEnrollment, EnrollBusinessInput } from './types.js'
+import type { PartnerRepository } from './repository.js'
+import { BUSINESS_ENROLLMENT_CREATED } from './events.js'
+
+export class EnrollmentService {
+  constructor(
+    private readonly repo: PartnerRepository,
+    private readonly syncEngine: SyncEngine,
+    private readonly deviceId: DeviceId,
+    private readonly employeeId: EmployeeId,
+  ) {}
+
+  async enrollBusiness(input: EnrollBusinessInput): Promise<BusinessEnrollment> {
+    const existing = await this.repo.getEnrollmentByBusiness(input.businessId)
+    if (existing) {
+      throw new Error(`Business ${input.businessId} is already enrolled`)
+    }
+
+    const now = new Date().toISOString() as ISO8601
+    const enrollment: BusinessEnrollment = {
+      id: newId(),
+      businessId: input.businessId,
+      salespersonProfileId: input.salespersonProfileId,
+      influencerId: input.influencerId ?? null,
+      packageId: input.packageId ?? null,
+      commissionRuleId: input.commissionRuleId ?? null,
+      status: 'active',
+      enrolledAt: now,
+      terminatedAt: null,
+      createdAt: now,
+      updatedAt: now,
+      version: 1,
+    }
+
+    await this.repo.upsertEnrollment(enrollment)
+    await this.emit(BUSINESS_ENROLLMENT_CREATED, enrollment, 'create', 'businessEnrollment')
+    return enrollment
+  }
+
+  async getEnrollmentByBusiness(businessId: BusinessId): Promise<BusinessEnrollment | null> {
+    return this.repo.getEnrollmentByBusiness(businessId)
+  }
+
+  async listEnrollmentsBySalesperson(
+    salespersonId: SalespersonProfileId,
+  ): Promise<BusinessEnrollment[]> {
+    return this.repo.listEnrollmentsBySalesperson(salespersonId)
+  }
+
+  async listEnrollmentsByInfluencer(
+    influencerId: InfluencerProfileId,
+  ): Promise<BusinessEnrollment[]> {
+    return this.repo.listEnrollmentsByInfluencer(influencerId)
+  }
+
+  private async emit(
+    eventType: string,
+    entity: BusinessEnrollment,
+    syncOp: SyncEvent['operation'],
+    entityKind: EntityKind,
+  ): Promise<void> {
+    const event: SyncEvent = {
+      id: newId() as SyncEvent['id'],
+      idempotencyKey: asIdempotencyKey(`${entity.id}:${eventType}`),
+      businessId: entity.businessId,
+      entityKind,
+      entityId: entity.id,
+      operation: syncOp,
+      originatingDeviceId: this.deviceId,
+      originatingEmployeeId: this.employeeId,
+      clientSequence: Date.now(),
+      clientCreatedAt: new Date().toISOString(),
+      entityVersion: 1,
+      payload: entity as unknown as Record<string, unknown>,
+      state: 'pending',
+    }
+    await this.syncEngine.enqueue(event)
+  }
+}
