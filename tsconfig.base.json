{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@soostori/core": ["packages/core/src/index.ts"],
      "@soostori/events": ["packages/events/src/index.ts"],
      "@soostori/schema": ["packages/schema/src/index.ts"],
      "@soostori/auth": ["packages/auth/src/index.ts"],
      "@soostori/storage": ["packages/storage/src/index.ts"],
      "@soostori/devices": ["packages/devices/src/index.ts"],
      "@soostori/offline": ["packages/offline/src/index.ts"],
      "@soostori/audit": ["packages/audit/src/index.ts"],
      "@soostori/notifications": ["packages/notifications/src/index.ts"],
      "@soostori/lan": ["packages/lan/src/index.ts"],
      "@soostori/sync": ["packages/sync/src/index.ts"],
      "@soostori/subscription": ["packages/subscription/src/index.ts"],
      "@soostori/payments": ["packages/payments/src/index.ts"],
      "@soostori/tuma": ["packages/tuma/src/index.ts"],
      "@soostori/whatsapp": ["packages/whatsapp/src/index.ts"],
      "@soostori/cloud": ["packages/cloud/src/index.ts"],
      "@soostori/products": ["packages/business/products/src/index.ts"],
      "@soostori/sales": ["packages/business/sales/src/index.ts"],
      "@soostori/customers": ["packages/business/customers/src/index.ts"],
      "@soostori/debts": ["packages/business/debts/src/index.ts"],
      "@soostori/business": ["packages/business/src/index.ts"],
      "@soostori/inventory": ["packages/inventory/src/index.ts"]
    }
  }
}
